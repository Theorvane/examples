{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"lib": ["ES2022", "ESNext.Decorators"],
		"types": ["node"]
	},
	"include": ["examples/**/*.ts", "test/**/*.ts"]
}
